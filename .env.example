# Copy to .env. Compose reads this; never commit .env.
POSTGRES_USER=tenderfit
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=tenderfit
DB_PORT=5433
WEB_PORT=8080

# Needed for real extraction and verdicts; not needed for the fictional demo.
ANTHROPIC_API_KEY=

# Accounts and sessions. Create the first account with: python -m tenderfit.auth create-user EMAIL
# Open sign-up stays off unless you want anyone who can reach this server to be able to register.
REGISTRATION_ENABLED=false
SESSION_HOURS=12
# Keep true whenever TenderFit is served over HTTPS. Set false only for plain http on localhost.
SESSION_COOKIE_SECURE=true
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15

# Find a Tender import
FTS_BASE_URL=https://www.find-tender.service.gov.uk/api/1.0
IMPORT_ENABLED=true
IMPORT_INTERVAL_HOURS=4
IMPORT_OVERLAP_MINUTES=60
STATUS_FRESH_HOURS=24

# Model use. Every model call is bounded per lot by these caps.
LLM_MODEL_EXTRACT=claude-opus-5-5
LLM_MODEL_AGENT=claude-opus-5-5
LLM_EFFORT=medium
LOT_COST_CAP_USD=0.50
LOT_TOKEN_CAP=400000
LOT_TIME_CAP_S=180
AGENT_ENABLED=true
AGENT_MAX_TOOL_CALLS=8

# No default on purpose: a retrieval score threshold must come from an evaluation on real data.
# RETRIEVAL_MIN_SCORE=
CORRECTIVE_MAX_ATTEMPTS=1
MAX_UPLOAD_BYTES=26214400

# Opt-in two-hop, snapshot-scoped retrieval and amendment reassessment.
# VERSIONRAG_ENABLED=true
